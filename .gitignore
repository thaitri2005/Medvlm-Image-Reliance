# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/

# Heavy / regenerable. Re-created by `medvlm prepare` from the committed manifests.
/data/
# Results from the stand-in models are plumbing checks, never findings.
results/mock/
results/smolvlm/
# Raw per-call model outputs: force-add a finished run with `git add -f outputs/<model>/<profile>`.
/outputs/

# Machine-local overrides and secrets
configs/local.yaml
.env
*.token

# Notebook / editor noise
.ipynb_checkpoints/
.vscode/
.DS_Store
*.zip

# Session logs (logs/*.log); attach one when reporting a problem
/logs/

# LaTeX intermediates (report/): keep main.pdf only
report/*.aux
report/*.bbl
report/*.brf
report/*.out
report/*.log
